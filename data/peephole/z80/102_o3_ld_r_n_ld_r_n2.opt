;; Removes useless LD's
;; Replaces;
;; LD r, XXX
;; LD r, YYY
;; With:
;; LD r, YYY
;;
;; Unless YYY reads r: LD h, (hl), LD l, (hl) and LD r, r all need the
;; first load to have happened.

OLEVEL: 3
OFLAG: 102

REPLACE {{
  ld $1, $2
  ld $1, $3
}}

IF {{
  ($3 <> $1) && !(($3 == "(hl)") && (($1 == h) || ($1 == l)))
}}

WITH {{
  ld $1, $3
}}
